# คัดลอกเป็น .env แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env)
# Railway จะตั้ง DATABASE_URL ให้อัตโนมัติเมื่อเพิ่ม PostgreSQL ในโปรเจกต์
DATABASE_URL=postgresql://user:password@host:5432/dbname

# หรือกำหนดแยกทีละตัว (ใช้ตอนรันบนเครื่องตัวเอง)
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=garbage_db
